{
    "name": "HONEYGAIN",
    "dashboard": "https://dashboard.honeygain.com/",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_honeygain",
        "hostname": "${DEVICE_NAME}_honeygain",
        "image": "honeygain/honeygain:latest",
        "environment": [
            "HONEYGAIN_DUMMY=''"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "command": [
            "-tou-accept",
            "-email",
            "${HONEYGAIN_EMAIL}",
            "-pass",
            "${HONEYGAIN_PASSWORD}",
            "-device",
            "${DEVICE_NAME}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD",
                "pidof",
                "honeygain"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "email": {},
        "password": {}
    },
    "install_limit": 1,
    "app_details": {
        "official_name": "Honeygain",
        "publisher": "Honeygain UAB",
        "official_url": "https://honeygain.com",
        "tos_url": "https://www.honeygain.com/terms-of-use/",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": 10,
            "max_devices_per_ip": 1,
            "max_ips_per_account": 10,
            "notes": "10 concurrent active devices per account. Exactly 1 device per IP - additional devices show 'Network overused' error. Devices inactive 14+ days don't count. Swarmbytes wholesale tier available for 100+ IPs."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": false,
            "vps": false,
            "vpn": false,
            "proxy": false,
            "mobile": true,
            "adjacent_ips_accepted": false,
            "adjacent_ips_max": 1,
            "ipv6": "partial",
            "geo_restrictions": "none known",
            "quality_notes": "Strictly residential/mobile. VPN/Datacenter IPs result in account suspension. VM/emulator support restricted."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-11"
        },
        "earnings": {
            "model": "per-GB credits",
            "min_payout": "$20 Honeygain; $0.50 JumpTask ($1 first payout)",
            "payout_methods": [
                "PayPal (Tipalti)",
                "JumpTask credits (GIFQ gift cards or PayPal)"
            ],
            "avg_monthly_residential_usd": "1-9",
            "avg_monthly_datacenter_usd": null
        },
        "confidence": "high",
        "sources": [
            "https://support.honeygain.com/hc/en-us/articles/30688365428636-How-to-request-a-payout",
            "https://support.honeygain.com/hc/en-us/articles/30688558061084-What-are-credits-JumpTask",
            "https://support.honeygain.com/hc/en-us/articles/30688479267868-How-to-run-Honeygain-on-Docker",
            "https://support.honeygain.com/hc/en-us/articles/30688346556956-How-many-devices-can-I-use-and-how-do-I-manage-them",
            "https://support.honeygain.com/hc/en-us/articles/30688404694428-Error-Network-overused"
        ],
        "last_verified": "2026-03-21"
    },
    "referrals": [
        {
            "url": "https://join.honeygain.com/MINDL15721",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "email": "yourHONEYGAINMail",
        "password": "yourHONEYGAINPw",
        "service_enabled": false
    },
    "profile": "residential"
}
