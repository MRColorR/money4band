{
    "name": "TITAN",
    "dashboard": "https://test1.titannet.io",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_titan",
        "hostname": "${DEVICE_NAME}_titan",
        "image": "nezha123/titan-edge:latest",
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "volumes": [
            ".data/.titanedge:/root/.titanedge"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f titan || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "hash": {
            "claimURLBase": "After starting, bind the device: docker run --rm -v .data/.titanedge:/root/.titanedge nezha123/titan-edge bind --hash=YOUR_HASH https://api-test1.container1.titannet.io/api/v2/device/binding"
        }
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "Titan Network",
        "publisher": "Titan Network",
        "official_url": "https://titannet.io",
        "tos_url": "undocumented",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented",
            "notes": "Edge compute platform. Two-step setup: run container, then bind device with identity hash."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "Edge compute network. Not pure bandwidth sharing."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-12"
        },
        "earnings": {
            "model": "compute-based",
            "min_payout": "undocumented",
            "payout_methods": [
                "undocumented"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "compose_layer_reasoning": "Edge compute platform. Conservative universal classification as IP policy is undocumented.",
        "install_limit_reasoning": "No documented caps. Two-step setup suggests per-device identity.",
        "recommendation": "promoted",
        "recommendation_reasoning": "Promoted to supported. Docker image verified on Docker Hub.",
        "confidence": "low",
        "confidence_notes": "Limited external validation. Primarily edge compute, not bandwidth sharing.",
        "sources": [],
        "last_verified": "2026-03-23"
    },
    "referrals": [
        {
            "url": "https://titannet.io",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "hash": "yourTITANHash"
    },
    "profile": "universal"
}
