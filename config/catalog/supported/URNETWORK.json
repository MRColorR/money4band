{
    "name": "URNETWORK",
    "dashboard": "https://ur.io/app",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_urnetwork",
        "hostname": "${DEVICE_NAME}_urnetwork",
        "image": "bringyour/community-provider:g4-latest",
        "command": "provide",
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "volumes": [
            ".data/.urnetwork:/root/.urnetwork"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f community || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "manual": {
            "instructions": "Run the URnetwork Docker auth command in the Money4Band app-management guide before starting this app. Authenticate using the same .data/.urnetwork directory mounted by its provider container."
        }
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "URnetwork",
        "publisher": "BringYour Inc.",
        "official_url": "https://ur.io",
        "tos_url": "undocumented",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented"
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "Supports direct connections and SOCKS5 proxy mode."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2026-03"
        },
        "earnings": {
            "model": "undocumented",
            "min_payout": "undocumented",
            "payout_methods": [
                "undocumented"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "confidence": "low",
        "sources": [
            "https://hub.docker.com/r/bringyour/community-provider",
            "https://ur.io",
            "https://ur.io/docs"
        ],
        "last_verified": "2026-11-19"
    },
    "referrals": [
        {
            "url": "https://ur.io/c?bonus=YDATQM",
            "code": "YDATQM",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false
    },
    "profile": "universal",
    "additional_details": "Referral code: YDATQM. Both parties receive 3 GiB/day of data allowance, up to 20 referrals."
}
