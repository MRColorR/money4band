{
  "name": "URNETWORK",
  "dashboard": "https://urnetwork.com/dashboard",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_urnetwork",
    "hostname": "${DEVICE_NAME}_urnetwork",
    "image": "bringyour/community-provider:latest",
    "command": "provide",
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "volumes": [
      ".data/.urnetwork:/root/.urnetwork"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_MEDIUM}",
    "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
    "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "pgrep -f community || exit 1"
      ],
      "interval": "120s",
      "timeout": "10s",
      "retries": 3,
      "start_period": "60s"
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null
  },
  "flags": {
    "auth_token": {
      "claimURLBase": "Requires initial 'docker run --rm -it bringyour/community-provider:latest auth' to generate JWT token. Copy the token to UR_AUTH_TOKEN."
    }
  },
  "install_limit": -1,
  "compose_layer": "universal",
  "app_details": {
    "official_name": "URnetwork",
    "publisher": "BringYour Inc.",
    "official_url": "https://urnetwork.com",
    "tos_url": "undocumented",
    "status": "active",
    "device_limits": {
      "max_devices_per_account": "undocumented",
      "max_devices_per_ip": "undocumented",
      "max_ips_per_account": "undocumented",
      "notes": "Supports standard and proxy mode (bulk operations with socks5 proxy file). JWT-based auth."
    },
    "ip_policy": {
      "residential": true,
      "datacenter": "undocumented",
      "vps": "undocumented",
      "vpn": "undocumented",
      "proxy": "undocumented",
      "mobile": "undocumented",
      "adjacent_ips_accepted": "undocumented",
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "none known",
      "quality_notes": "Marketplace penalizes same-subnet providers. IP diversity increases traffic weight. Supports proxy mode for fleetshare-style bulk operations."
    },
    "docker": {
      "image_official": true,
      "image_maintained": true,
      "last_update": "2026-03"
    },
    "earnings": {
      "model": "undocumented",
      "min_payout": "undocumented",
      "payout_methods": [
        "undocumented"
      ],
      "avg_monthly_residential_usd": "unknown",
      "avg_monthly_datacenter_usd": "unknown"
    },
    "compose_layer_reasoning": "Supports proxy mode for bulk operations suggesting DC/VPS acceptance. Conservative universal classification.",
    "install_limit_reasoning": "No documented device caps. Proxy mode suggests scale-friendly design.",
    "recommendation": "promoted",
    "recommendation_reasoning": "Promoted to supported. Docker image verified on Docker Hub.",
    "confidence": "low",
    "confidence_notes": "Limited external validation. Requires deeper research before promoting to supported.",
    "sources": [],
    "last_verified": "2026-03-23"
  },
  "referrals": [
    {
      "url": "https://urnetwork.com",
      "contributor": "MRColorR"
    }
  ],
  "user_config_template": {
    "enabled": false,
    "auth_token": "yourURNETWORKAuthToken"
  }
}
