{
    "name": "TRAFFMONETIZER",
    "dashboard": "https://app.traffmonetizer.com/dashboard",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_traffmonetizer",
        "hostname": "${DEVICE_NAME}_traffmonetizer",
        "image": "traffmonetizer/cli_v2:latest",
        "environment": [
            "TRAFFMONETIZER_DUMMY=''"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "command": [
            "start",
            "accept",
            "status",
            "--token",
            "${TRAFFMONETIZER_TOKEN}",
            "--device-name",
            "${DEVICE_NAME}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_LITTLE}",
        "mem_reservation": "${APP_MEM_RESERV_LITTLE}",
        "mem_limit": "${APP_MEM_LIMIT_LITTLE}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f Cli || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "token": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "TraffMonetizer",
        "publisher": "TraffMonetizer",
        "official_url": "https://traffmonetizer.com",
        "tos_url": "https://traffmonetizer.com/terms-of-service/",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "unlimited",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "unlimited",
            "notes": "The terms state that devices on the same public IP share the available traffic."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": false,
            "vps": false,
            "vpn": false,
            "proxy": false,
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "The provider requires a residential IP and prohibits servers, VPNs and proxies."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2025-01"
        },
        "earnings": {
            "model": "per-GB (credits)",
            "min_payout": "$10",
            "payout_methods": [
                "PayPal",
                "crypto",
                "wire transfer"
            ],
            "avg_monthly_residential_usd": "0.5-2",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "confidence": "medium",
        "sources": [
            "https://traffmonetizer.com/terms-of-service/",
            "https://traffmonetizer.com/downloads/"
        ],
        "last_verified": "2026-03-21",
        "compose_layer_reasoning": "Residential connections only, as required by the provider terms.",
        "install_limit_reasoning": "No device cap stated in the terms.",
        "recommendation": "keep",
        "recommendation_reasoning": "Keep the published Docker client for supported residential use.",
        "confidence_notes": "Provider terms define network eligibility. The May 2026 container test confirmed the status argument prints a connection summary at startup."
    },
    "referrals": [
        {
            "url": "https://traffmonetizer.com/?aff=366499",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "token": "yourTRAFFMONETIZERToken"
    },
    "profile": "residential"
}
