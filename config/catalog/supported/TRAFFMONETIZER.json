{
    "name": "TRAFFMONETIZER",
    "dashboard": "https://app.traffmonetizer.io/",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_traffmonetizer",
        "hostname": "${DEVICE_NAME}_traffmonetizer",
        "image": "traffmonetizer/cli_v2:latest",
        "environment": [
            "HOME=/var/lib/tm"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "command": [
            "--token",
            "${TRAFFMONETIZER_TOKEN}",
            "--device-name",
            "${DEVICE_NAME}",
            "start",
            "accept"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_LITTLE}",
        "mem_reservation": "${APP_MEM_RESERV_LITTLE}",
        "mem_limit": "${APP_MEM_LIMIT_LITTLE}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "disable": true
        },
        "volumes": [
            ".data/.traffmonetizer:/var/lib/tm"
        ]
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "token": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "TraffMonetizer",
        "publisher": "TraffMonetizer",
        "official_url": "https://traffmonetizer.io",
        "tos_url": "https://traffmonetizer.io/terms-of-service/",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "unlimited",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "unlimited",
            "notes": "The terms state that devices on the same public IP share the available traffic."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": false,
            "vps": false,
            "vpn": false,
            "proxy": false,
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "The provider requires a residential IP and prohibits servers, VPNs and proxies."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2025-01"
        },
        "earnings": {
            "model": "per-GB (credits)",
            "min_payout": "$10 (wire transfer: $1,000)",
            "payout_methods": [
                "USDT (TRC20; check dashboard for other networks)",
                "wire transfer ($1,000 minimum)"
            ],
            "avg_monthly_residential_usd": "0.5-2",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "confidence": "medium",
        "sources": [
            "https://traffmonetizer.io/",
            "https://traffmonetizer.io/terms-of-service/",
            "https://hub.docker.com/r/traffmonetizer/cli_v2"
        ],
        "last_verified": "2026-11-19",
        "compose_layer_reasoning": "Residential connections only, as required by the provider terms.",
        "install_limit_reasoning": "No device cap stated in the terms.",
        "recommendation": "keep",
        "recommendation_reasoning": "Keep the published Docker client for supported residential use.",
        "confidence_notes": "Current official Docker documentation and registry verified. ARM tags arm64v8 and arm32v7 publish matching architecture metadata. HOME and persistent storage preserve identity. The current image has no shell; the previous shell health check is disabled. Authenticated connectivity and payouts remain untested in this review."
    },
    "referrals": [
        {
            "url": "https://traffmonetizer.io/?aff=366499",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "token": "yourTRAFFMONETIZERToken"
    },
    "profile": "residential",
    "additional_details": "TraffMonetizer moved to traffmonetizer.io. Pull the current image before recreating older containers. Keep the .data/.traffmonetizer directory to preserve the device identity; adding this storage to an older stateless container registers a new identity once. The official public site lists a $10 minimum, USDT TRC20 and wire transfers from $1,000; check the account dashboard for current payout networks."
}
