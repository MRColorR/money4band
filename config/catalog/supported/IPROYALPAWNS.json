{
    "name": "IPROYALPAWNS",
    "dashboard": "https://dashboard.pawns.app/",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_iproyalpawns",
        "hostname": "${DEVICE_NAME}_iproyalpawns",
        "image": "iproyal/pawns-cli:latest",
        "environment": [
            "IPROYALPAWNS_DUMMY=''"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "command": [
            "-accept-tos",
            "-email=${IPROYALPAWNS_EMAIL}",
            "-password=${IPROYALPAWNS_PASSWORD}",
            "-device-name=${DEVICE_NAME}",
            "-device-id=id_${DEVICE_NAME}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_LITTLE}",
        "mem_reservation": "${APP_MEM_RESERV_LITTLE}",
        "mem_limit": "${APP_MEM_LIMIT_LITTLE}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f pawns || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "email": {},
        "password": {}
    },
    "install_limit": 1,
    "app_details": {
        "official_name": "Pawns (IPRoyal)",
        "publisher": "IPRoyal",
        "official_url": "https://pawns.app",
        "tos_url": "https://iproyal.com/terms-of-service/",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "unlimited",
            "max_devices_per_ip": 1,
            "max_ips_per_account": "unlimited",
            "notes": "1 node per unique public IP. Unlimited accounts but each requires distinct public IP. Cloning VMs on same IP explicitly disallowed and may trigger bans."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": false,
            "vps": false,
            "vpn": false,
            "proxy": false,
            "mobile": true,
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "IPRoyal custom monitoring prevents datacenter IPs. Datacenter ASNs automatically removed from pool."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-10"
        },
        "earnings": {
            "model": "per-GB",
            "min_payout": "$5",
            "payout_methods": [
                "PayPal",
                "crypto",
                "gift cards"
            ],
            "avg_monthly_residential_usd": "0.5-2",
            "avg_monthly_datacenter_usd": null
        },
        "confidence": "high",
        "sources": [
            "https://iproyal.com/IPRoyal_Residential_Proxy_Sourcing_Documentation.pdf",
            "https://greenfrognest.com/IPRoyalLMDS.php"
        ],
        "last_verified": "2026-03-21",
        "compose_layer_reasoning": "IPRoyal custom monitoring prevents datacenter IPs. Datacenter ASNs automatically removed from pool.",
        "install_limit_reasoning": "1 node per unique public IP. Cloning VMs on same IP explicitly disallowed and may trigger bans.",
        "recommendation": "update-config",
        "recommendation_reasoning": "Corrected install_limit to 1 per IP. IPRoyal Sourcing Documentation confirms strict per-IP enforcement.",
        "confidence_notes": "IPRoyal proxy sourcing documentation and community reports confirm residential-only policy."
    },
    "referrals": [
        {
            "url": "https://pawns.app?r=MiNe",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "email": "yourIPROYALPAWNSMail",
        "password": "yourIPROYALPAWNSPw"
    },
    "profile": "residential"
}
