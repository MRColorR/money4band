{
    "name": "ANTGAIN",
    "dashboard": "https://antgain.app/dashboard",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_antgain",
        "hostname": "${DEVICE_NAME}_antgain",
        "image": "pinors/antgain-cli:latest",
        "platform": "linux/amd64",
        "environment": [
            "ANTGAIN_API_KEY=${ANTGAIN_APIKEY}"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "volumes": [
            ".data/.antgain:/data"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "disable": true
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "apikey": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "AntGain",
        "publisher": "AntGain",
        "official_url": "https://antgain.app",
        "tos_url": "undocumented",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented",
            "notes": "Limited documentation. Other projects support it. linux/amd64 platform only."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "undocumented",
            "quality_notes": "Insufficient documentation."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2026-02"
        },
        "earnings": {
            "model": "undocumented",
            "min_payout": "undocumented",
            "payout_methods": [
                "undocumented"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
