{
    "name": "ANTGAIN",
    "dashboard": "https://antgain.app/dashboard",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_antgain",
        "hostname": "${DEVICE_NAME}_antgain",
        "image": "pinors/antgain-cli:latest",
        "environment": [
            "ANTGAIN_API_KEY=${ANTGAIN_APIKEY}"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "volumes": [
            ".data/.antgain:/data"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD",
                "antgain",
                "health"
            ],
            "interval": "30s",
            "timeout": "5s",
            "start_period": "120s",
            "retries": 3
        },
        "stop_grace_period": "30s"
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "apikey": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "AntGain",
        "publisher": "AntGain",
        "official_url": "https://antgain.app",
        "tos_url": "undocumented",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented",
            "notes": "The published Docker manifest provides linux/amd64, linux/arm64 and linux/arm/v7. Native amd64 and emulated arm64 CLI startup were checked."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "undocumented",
            "quality_notes": "Insufficient documentation."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2026-10"
        },
        "earnings": {
            "model": "undocumented",
            "min_payout": "$5",
            "payout_methods": [
                "undocumented"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "warnings": [
            "Authenticated enrollment and payouts have not been verified by this catalog review."
        ],
        "confidence": "low",
        "sources": [
            "https://docs.antgain.app/node/docker",
            "https://docs.antgain.app/rewards"
        ],
        "last_verified": "2026-11-19",
        "compose_layer_reasoning": "Insufficient documentation. Conservative datacenter classification.",
        "install_limit_reasoning": "No documented account-wide device cap. Check current provider terms before deploying multiple nodes.",
        "recommendation": "promoted",
        "recommendation_reasoning": "Promoted to supported. Docker image verified on Docker Hub.",
        "confidence_notes": "Official image and API-key environment match the current Docker guide. The existing /data parent mount retains /data/.antgain state. Dashboard and referral checked; authenticated enrollment and payouts were not tested."
    },
    "referrals": [
        {
            "url": "https://link.antgain.app/EYOOXFDK",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "apikey": "yourANTGAINAPIKey"
    },
    "profile": "datacenter"
}
