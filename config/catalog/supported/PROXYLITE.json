{
    "name": "PROXYLITE",
    "dashboard": "https://proxylite.ru/",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_proxylite",
        "hostname": "${DEVICE_NAME}_proxylite",
        "image": "proxylite/proxyservice:latest",
        "environment": [
            "USER_ID=$PROXYLITE_USERID"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_BIG}",
        "mem_reservation": "${APP_MEM_RESERV_BIG}",
        "mem_limit": "${APP_MEM_LIMIT_BIG}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f proxyservice || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "userid": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "ProxyLite",
        "publisher": "ProxyLite",
        "official_url": "https://proxylite.ru",
        "tos_url": "https://www.proxylite.com/terms-of-service",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "unlimited",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "unlimited",
            "notes": "Commercial proxy provider using P2P nodes. No documented device cap."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": true,
            "vps": true,
            "vpn": "undocumented",
            "proxy": true,
            "mobile": true,
            "adjacent_ips_accepted": true,
            "adjacent_ips_max": "unlimited",
            "ipv6": true,
            "geo_restrictions": "Does not support mainland China. Russian-origin service \u2014 international availability may vary.",
            "quality_notes": "Supports residential, static datacenter, and ISP proxy types. Community VPS deployments widely practiced with no ban reports."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-12"
        },
        "earnings": {
            "model": "per-GB",
            "min_payout": "undocumented",
            "payout_methods": [
                "crypto"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "confidence": "medium",
        "sources": [
            "https://www.proxylite.com/",
            "https://hub.docker.com/u/proxylite",
            "https://www.reddit.com/r/oraclecloud/comments/1df74jc/"
        ],
        "last_verified": "2026-03-21",
        "compose_layer_reasoning": "Supports residential, static datacenter, and ISP proxy types. Community VPS deployments widely practiced with no ban reports. Russian-origin service.",
        "install_limit_reasoning": "Commercial scale supports high device density. No documented device cap.",
        "recommendation": "update-config",
        "recommendation_reasoning": "Changed compose_layer from datacenter to universal. Verified support for all IP types including residential.",
        "confidence_notes": "Live service site and dashboard verified. Reddit VPS deployment reports confirm multi-IP-type support."
    },
    "referrals": [
        {
            "url": "https://proxylite.ru/?r=PJTKXWN3",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "userid": "yourPROXYLITEUserID"
    },
    "profile": "universal"
}
