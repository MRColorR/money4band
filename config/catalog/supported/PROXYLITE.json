{
    "name": "PROXYLITE",
    "dashboard": "https://lk.proxylite.ru/",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_proxylite",
        "hostname": "${DEVICE_NAME}_proxylite",
        "image": "proxylite/proxyservice:latest",
        "environment": [
            "USER_ID=$PROXYLITE_USERID"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_BIG}",
        "mem_reservation": "${APP_MEM_RESERV_BIG}",
        "mem_limit": "${APP_MEM_LIMIT_BIG}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f proxyservice || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "userid": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "ProxyLite",
        "publisher": "ProxyLite",
        "official_url": "https://proxylite.ru",
        "tos_url": "https://app.proxylite.ru/legal/proxylite_android_user_agreement.pdf",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented",
            "notes": "Multiple devices require distinct public IPs. Account-wide limits are undocumented."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": true,
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "undocumented",
            "quality_notes": "Residential computers and Android devices. Datacenter, VPN and proxy eligibility is undocumented."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2022-01-22"
        },
        "earnings": {
            "model": "bandwidth sharing (Coins)",
            "min_payout": "undocumented",
            "payout_methods": [
                "Sberbank (Russia)",
                "mobile credit (supported countries)",
                "YuMoney",
                "bank cards (Belarus)"
            ],
            "avg_monthly_residential_usd": "unknown",
            "avg_monthly_datacenter_usd": "unknown"
        },
        "confidence": "medium",
        "sources": [
            "https://proxylite.ru/",
            "https://proxylite.ru/download.php",
            "https://proxylite.ru/faq.php",
            "https://hub.docker.com/r/proxylite/proxyservice",
            "https://app.proxylite.ru/legal/proxylite_android_user_agreement.pdf"
        ],
        "last_verified": "2026-03-21"
    },
    "referrals": [
        {
            "url": "https://proxylite.ru/?r=PJTKXWN3",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "userid": "yourPROXYLITEUserID"
    },
    "profile": "universal"
}
