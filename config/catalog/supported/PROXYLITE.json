            "notes": "The earning-service site describes multiple devices with distinct public IPs; no account-wide device/IP cap is published."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": "undocumented",
            "vps": "undocumented",
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": true,
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "undocumented; review the linked earning-service agreement",
