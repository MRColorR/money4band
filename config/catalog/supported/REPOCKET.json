{
    "name": "REPOCKET",
    "dashboard": "https://repocket.com/dashboard/share-internet",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_repocket",
        "hostname": "${DEVICE_NAME}_repocket",
        "image": "repocket/repocket:latest",
        "environment": [
            "RP_API_KEY=$REPOCKET_APIKEY"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "disable": true
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "apikey": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "Repocket",
        "publisher": "Repocket",
        "official_url": "https://repocket.com",
        "tos_url": "https://repocket.com/eula",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented"
        },
        "ip_policy": {
            "residential": true,
            "datacenter": true,
            "vps": true,
            "vpn": "partial",
            "proxy": "undocumented",
            "mobile": true,
            "adjacent_ips_accepted": true,
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "Residential, datacenter and mobile connections are accepted."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-12"
        },
        "earnings": {
            "model": "per-GB",
            "min_payout": "$20",
            "payout_methods": [
                "PayPal",
                "crypto"
            ],
            "avg_monthly_residential_usd": "1-5",
            "avg_monthly_datacenter_usd": "0.5-2"
        },
        "confidence": "medium",
        "sources": [
            "https://essay.utwente.nl/fileshare/file/108490/thesis-1.pdf",
            "https://blog.vpslog.org/blog/profit/",
            "https://hub.docker.com/r/repocket/repocket"
        ],
        "last_verified": "2026-03-21"
    },
    "referrals": [
        {
            "url": "https://link.repocket.co/hr8i",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "apikey": "yourREPOCKETAPIKey"
    },
    "profile": "datacenter"
}
