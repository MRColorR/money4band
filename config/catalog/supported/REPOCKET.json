{
  "name": "REPOCKET",
  "dashboard": "https://app.repocket.co/#home",
  "compose_config": {
    "container_name": "${DEVICE_NAME}_repocket",
    "hostname": "${DEVICE_NAME}_repocket",
    "image": "repocket/repocket:latest",
    "environment": [
      "RP_EMAIL=$REPOCKET_EMAIL",
      "RP_API_KEY=$REPOCKET_APIKEY"
    ],
    "labels": [
      "com.centurylinklabs.watchtower.enable=true",
      "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
    ],
    "restart": "always",
    "cpus": "${APP_CPU_LIMIT_MEDIUM}",
    "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
    "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
    "logging": {
      "driver": "json-file",
      "options": {
        "max-size": "10m",
        "max-file": "3"
      }
    },
    "healthcheck": {
      "test": [
        "CMD-SHELL",
        "pgrep -f repocket || exit 1"
      ],
      "interval": "120s",
      "timeout": "10s",
      "retries": 3,
      "start_period": "60s"
    }
  },
  "compose_config_proxy": {
    "network_mode": "service:proxy",
    "hostname": null
  },
  "flags": {
    "email": {},
    "apikey": {}
  },
  "install_limit": -1,
  "compose_layer": "datacenter",
  "app_details": {
    "official_name": "Repocket",
    "publisher": "Repocket",
    "official_url": "https://repocket.co",
    "tos_url": "https://repocket.co/terms",
    "status": "active",
    "device_limits": {
      "max_devices_per_account": "unlimited",
      "max_devices_per_ip": "undocumented",
      "max_ips_per_account": "unlimited",
      "notes": "No documented device cap. Mixed Trustpilot reviews note inability to see all connected devices in dashboard."
    },
    "ip_policy": {
      "residential": true,
      "datacenter": true,
      "vps": true,
      "vpn": "partial",
      "proxy": "undocumented",
      "mobile": true,
      "adjacent_ips_accepted": true,
      "adjacent_ips_max": "undocumented",
      "ipv6": "undocumented",
      "geo_restrictions": "none known",
      "quality_notes": "Frequently cited as VPS-friendly. Port 7072 identified in traffic analysis."
    },
    "docker": {
      "image_official": true,
      "image_maintained": true,
      "last_update": "2024-12"
    },
    "earnings": {
      "model": "per-GB",
      "min_payout": "$20",
      "payout_methods": [
        "PayPal",
        "crypto"
      ],
      "avg_monthly_residential_usd": "1-5",
      "avg_monthly_datacenter_usd": "0.5-2"
    },
    "confidence": "medium",
    "sources": [
      "https://essay.utwente.nl/fileshare/file/108490/thesis-1.pdf",
      "https://blog.vpslog.org/blog/profit/"
    ],
    "last_verified": "2026-03-21",
    "compose_layer_reasoning": "Frequently cited as VPS-friendly in academic research and community reports. Port 7072 identified in traffic analysis.",
    "install_limit_reasoning": "No documented device cap. Mixed Trustpilot reviews note dashboard limitations but no ban reports for multi-device.",
    "recommendation": "keep",
    "recommendation_reasoning": "Datacenter layer and unlimited limit are correct. VPS-friendly confirmed.",
    "confidence_notes": "University of Twente thesis and community blog analyses confirm VPS acceptance."
  },
  "referrals": [
    {
      "url": "https://link.repocket.co/hr8i",
      "contributor": "MRColorR"
    }
  ],
  "user_config_template": {
    "enabled": false,
    "email": "yourREPOCKETMail",
    "apikey": "yourREPOCKETAPIKey"
  }
}
