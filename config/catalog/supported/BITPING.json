{
    "name": "BITPING",
    "dashboard": "https://app.bitping.com/earnings",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_bitping",
        "hostname": "${DEVICE_NAME}_bitping",
        "image": "bitping/bitpingd:latest",
        "environment": [
            "BITPING_EMAIL=$BITPING_EMAIL",
            "BITPING_PASSWORD=$BITPING_PASSWORD"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "volumes": [
            ".data/.bitpingd:/root/.bitpingd"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_BIG}",
        "mem_reservation": "${APP_MEM_RESERV_BIG}",
        "mem_limit": "${APP_MEM_LIMIT_BIG}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "pgrep -f bitpingd || exit 1"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "email": {},
        "password": {},
        "mfa": {}
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "Bitping",
        "publisher": "Bitping",
        "official_url": "https://bitping.com",
        "tos_url": "https://bitping.com/terms",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "unlimited",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "unlimited",
            "notes": "No documented device cap. Officially supports servers, PCs, and Raspberry Pi. Docker explicitly supported."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": true,
            "vps": true,
            "vpn": "undocumented",
            "proxy": "undocumented",
            "mobile": false,
            "adjacent_ips_accepted": true,
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "Network monitoring/testing model (not pure bandwidth sharing). Node quality depends on geo location and latency, not IP type. Servers explicitly listed as supported."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2025-01"
        },
        "earnings": {
            "model": "task-based (network monitoring)",
            "min_payout": "$1 BITPING token",
            "payout_methods": [
                "BITPING token (crypto)",
                "USDC"
            ],
            "avg_monthly_residential_usd": "0.1-1",
            "avg_monthly_datacenter_usd": "0.1-1"
        },
        "confidence": "high",
        "sources": [
            "https://bitping.com/help/nodes/system-requirements"
        ],
        "last_verified": "2026-03-21",
        "compose_layer_reasoning": "Network monitoring/testing model (not pure bandwidth sharing). Node quality depends on geo location and latency, not IP type. Servers explicitly listed as supported platform.",
        "install_limit_reasoning": "No documented device cap. Officially supports servers, PCs, and Raspberry Pi. Docker explicitly supported.",
        "recommendation": "keep",
        "recommendation_reasoning": "Datacenter layer and unlimited limit are correct. Task-based model accepts all IP types.",
        "confidence_notes": "Bitping system requirements page confirms server and Docker support."
    },
    "referrals": [
        {
            "url": "https://app.bitping.com?r=qm7mIuX3",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "email": "yourBITPINGMail",
        "password": "yourBITPINGPw"
    },
    "profile": "datacenter"
}
