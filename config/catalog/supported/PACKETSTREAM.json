{
    "name": "PACKETSTREAM",
    "dashboard": "https://app.packetstream.io/dashboard",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_packetstream",
        "hostname": "${DEVICE_NAME}_packetstream",
        "image": "packetstream/psclient:latest",
        "environment": [
            "CID=$PACKETSTREAM_CID"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_MEDIUM}",
        "mem_reservation": "${APP_MEM_RESERV_MEDIUM}",
        "mem_limit": "${APP_MEM_LIMIT_MEDIUM}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD",
                "pidof",
                "psclient"
            ],
            "interval": "120s",
            "timeout": "10s",
            "retries": 3,
            "start_period": "60s"
        }
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null
    },
    "flags": {
        "cid": {
            "instructions": "Open https://app.packetstream.io/dashboard/download, select Linux and copy the CID from the installation command, without quotes."
        }
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "PacketStream",
        "publisher": "PacketStream",
        "official_url": "https://packetstream.io",
        "tos_url": "https://packetstream.io/terms-of-service/",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": "undocumented",
            "max_ips_per_account": "undocumented",
            "notes": "Use distinct public IPs for multiple devices."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": false,
            "vps": false,
            "vpn": false,
            "proxy": false,
            "mobile": "undocumented",
            "adjacent_ips_accepted": "undocumented",
            "adjacent_ips_max": "undocumented",
            "ipv6": "undocumented",
            "geo_restrictions": "none known",
            "quality_notes": "Residential connections only; datacenter and business IPs are not accepted."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2024-12"
        },
        "earnings": {
            "model": "per-GB",
            "min_payout": "$5",
            "payout_methods": [
                "PayPal"
            ],
            "avg_monthly_residential_usd": "0.5-1.5",
            "avg_monthly_datacenter_usd": null
        },
        "confidence": "high",
        "sources": [
            "https://packetstream.io/share-bandwidth/",
            "https://packetstream.io/install.sh"
        ],
        "last_verified": "2026-03-21"
    },
    "referrals": [
        {
            "url": "https://packetstream.io/share-bandwidth/?psr=v3wayrm3g9",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "cid": "yourPACKETSTREAMCID"
    },
    "profile": "residential",
    "additional_details": "Copy the CID from the Linux installation command in your account dashboard."
}
