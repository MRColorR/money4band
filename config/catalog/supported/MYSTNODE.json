{
    "name": "MYSTNODE",
    "manual_onboard": true,
    "dashboard": "https://my.mystnodes.com/nodes",
    "compose_config": {
        "container_name": "${DEVICE_NAME}_mystnode",
        "hostname": "${DEVICE_NAME}_mystnode",
        "image": "mysteriumnetwork/myst:latest",
        "environment": [
            "MYSTNODE_DUMMY=''"
        ],
        "labels": [
            "com.centurylinklabs.watchtower.enable=true",
            "com.centurylinklabs.watchtower.scope=${M4B_WATCHTOWER_SCOPE}"
        ],
        "command": "service --agreed-terms-and-conditions",
        "cap_add": [
            "NET_ADMIN"
        ],
        "ports": [
            "${MYSTNODE_PORT}:4449"
        ],
        "volumes": [
            ".data/mysterium-node:/var/lib/mysterium-node"
        ],
        "restart": "always",
        "cpus": "${APP_CPU_LIMIT_HUGE}",
        "mem_reservation": "${APP_MEM_RESERV_HUGE}",
        "mem_limit": "${APP_MEM_LIMIT_HUGE}",
        "logging": {
            "driver": "json-file",
            "options": {
                "max-size": "10m",
                "max-file": "3"
            }
        },
        "healthcheck": {
            "test": [
                "CMD-SHELL",
                "wget -q --spider http://127.0.0.1:4449/healthcheck 2>/dev/null || wget -q --spider http://127.0.0.1:4449/ 2>/dev/null || pgrep -f myst || exit 1"
            ],
            "interval": "120s",
            "timeout": "15s",
            "retries": 3,
            "start_period": "90s"
        },
        "devices": [
            "/dev/net/tun:/dev/net/tun"
        ]
    },
    "compose_config_proxy": {
        "network_mode": "service:proxy",
        "hostname": null,
        "ports": null
    },
    "flags": {
        "manual": {
            "instructions": "After starting the stack, open the local WebUI shown in the setup summary. Complete onboarding, choose your beneficiary wallet and claim the node at https://my.mystnodes.com/nodes. Keep .data/mysterium-node to preserve its identity. The Docker host needs /dev/net/tun. Use an SSH tunnel to reach the WebUI on a remote host."
        }
    },
    "install_limit": -1,
    "app_details": {
        "official_name": "Mysterium",
        "publisher": "Mysterium Network Foundation",
        "official_url": "https://mystnodes.com",
        "tos_url": "https://www.mystnodes.com/legal/terms-and-conditions",
        "status": "active",
        "device_limits": {
            "max_devices_per_account": "undocumented",
            "max_devices_per_ip": 1,
            "max_ips_per_account": "undocumented",
            "notes": "Each node needs a distinct public IP."
        },
        "ip_policy": {
            "residential": true,
            "datacenter": true,
            "vps": true,
            "vpn": "partial",
            "proxy": false,
            "mobile": "undocumented",
            "adjacent_ips_accepted": true,
            "adjacent_ips_max": "unlimited",
            "ipv6": true,
            "geo_restrictions": "none known",
            "quality_notes": "Task availability depends on IP location and quality."
        },
        "docker": {
            "image_official": true,
            "image_maintained": true,
            "last_update": "2025-03"
        },
        "earnings": {
            "model": "per-GB + per-session (MYST token)",
            "min_payout": "None (continuous streaming to wallet)",
            "payout_methods": [
                "MYST token",
                "ETH",
                "BNB"
            ],
            "avg_monthly_residential_usd": "1-15",
            "avg_monthly_datacenter_usd": "0.5-3"
        },
        "warnings": [
            "Requires /dev/net/tun and NET_ADMIN."
        ],
        "confidence": "high",
        "sources": [
            "https://mystnodes.com",
            "https://hub.docker.com/r/mysteriumnetwork/myst",
            "https://github.com/mysteriumnetwork/node",
            "https://help.mystnodes.com/en/articles/8005230-tun-device-errors-and-troubleshooting",
            "https://help.mystnodes.com/en/articles/8006242-running-a-mystnodes-as-docker-image-on-windows-and-macos-hosts"
        ],
        "last_verified": "2026-03-21"
    },
    "referrals": [
        {
            "url": "https://mystnodes.co/?referral_code=Tc7RaS7Fm12K3Xun6mlU9q9hbnjojjl9aRBW8ZA9",
            "contributor": "MRColorR"
        }
    ],
    "user_config_template": {
        "enabled": false,
        "ports": [
            4449
        ]
    },
    "profile": "universal"
}
