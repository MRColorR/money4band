# Money4Band — Environment File Template
# This file is generated by the setup wizard (generator.py).
# Copy to .env and fill in your values, or run M4B setup to auto-generate.
#
# NEVER commit .env with real credentials to version control.

# --- Project ---
PROJECT_VERSION=5.0.0
COMPOSE_PROJECT_NAME=money4band
DS_PROJECT_SERVER_URL=https://discord.com/invite/Fq8eeazBAD

# --- Resource Limits ---
# Auto-calculated at runtime by detector.py from the active resource profile
# (minimal / conservative / standard / performance) and detected system specs.
# The values below are examples only — actual values depend on your hardware.
APP_CPU_LIMIT_LITTLE=0.5
APP_CPU_LIMIT_MEDIUM=1.0
APP_CPU_LIMIT_BIG=1.5
APP_CPU_LIMIT_HUGE=2.0
APP_MEM_RESERV_LITTLE=256m
APP_MEM_LIMIT_LITTLE=512m
APP_MEM_RESERV_MEDIUM=512m
APP_MEM_LIMIT_MEDIUM=1024m
APP_MEM_RESERV_BIG=1024m
APP_MEM_LIMIT_BIG=1536m
APP_MEM_RESERV_HUGE=1536m
APP_MEM_LIMIT_HUGE=2048m

# --- Networking ---
NETWORK_DRIVER=bridge
NETWORK_SUBNET=172.19.7.0
NETWORK_NETMASK=27

# --- Device ---
DEVICE_NAME=yourDeviceName
OS_TYPE=Linux
DETECTED_ARCHITECTURE=amd64
DETECTED_DOCKER_ARCH=amd64

# --- Proxy ---
STACK_PROXY_ENABLED=False
STACK_PROXY_URL=
STACK_PROXY_URL_EXAMPLE=protocol://username:password@ip:port

# --- Watchtower ---
M4B_WATCHTOWER_LABELS=true
M4B_WATCHTOWER_SCOPE=money4band

# --- App Credentials (fill in your own values) ---
# EARNAPP_UUID=sdk-node-yourEARNAPPDeviceUUID
# HONEYGAIN_EMAIL=yourHONEYGAINMail
# HONEYGAIN_PASSWORD=yourHONEYGAINPw
# IPROYALPAWNS_EMAIL=yourIPROYALPAWNSMail
